# Ignore everything in ~/.claude by default
*

# Track only hand-written config
!.gitignore
!README.md
!LICENSE
!CLAUDE.md

# Directories of hand-written extensions (tracked when they exist)
!agents/
!agents/**
!commands/
!commands/**
!skills/
!skills/**
!hooks/
!hooks/**
!output-styles/
!output-styles/**
!rules/
!rules/**
!scripts/
!scripts/**
